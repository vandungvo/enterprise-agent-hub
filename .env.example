# Copy to .env and fill in

# LLM provider: anthropic (Claude, default) | gemini (Google)
#   | groq | ollama | lmstudio | openrouter | openai  (OpenAI-compatible Chat Completions)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Gemini: key from https://aistudio.google.com/apikey (the project may need billing enabled)
# GOOGLE_API_KEY=AIza...
# Model used for agents whose platform.yaml model is a Claude id (or set `model: gemini-...` per agent)
# GEMINI_MODEL=gemini-2.5-flash
# OpenAI-compatible (free: Groq at https://console.groq.com/keys, or local Ollama)
# GROQ_API_KEY=gsk_...          # or OPENAI_API_KEY
# OPENAI_MODEL=openai/gpt-oss-120b   # default per provider: groq openai/gpt-oss-120b, ollama qwen3:4b
# OPENAI_BASE_URL=              # empty: the provider's default endpoint (e.g. http://localhost:11434/v1 for ollama)
# OPENAI_MAX_TOKENS=4096        # per-call completion cap; free tiers count it against tokens-per-minute

# RAG: none (BM25 only, no extra deps) | fastembed (hybrid BM25 + dense; pip install fastembed)
RAG_EMBEDDINGS=none
# RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RAG_CHUNK_SIZE=900
# RAG_CHUNK_OVERLAP=150

# Agent runtime
# AGENT_MAX_ITERATIONS=8
# AGENT_MAX_TOKENS=32000
# AGENT_USE_FALLBACKS=true   # server-side refusal fallback (fallbacks: "default")

# AGENTHUB_DATA_DIR=./data
# AGENTHUB_CONFIG=./config/platform.yaml
